{
  "name": "nix",
  "account_id": "39bf5f7ab4e3524825a484793939cd6b",
  "main": "api/worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "node scripts/build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/intent",
      "/intent/*",
      "/intents",
      "/intents/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nix-ask",
      "database_id": "0b12480b-d064-4f63-863d-34a7d144b3d0"
    }
  ],
  "triggers": {
    "crons": [
      "15 8 * * *",
      "*/15 * * * *"
    ]
  },
  "routes": [
    {
      "pattern": "core-nix.com",
      "custom_domain": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PIONEER",
        "class_name": "PioneerAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "pioneer-v1",
      "new_sqlite_classes": [
        "PioneerAgent"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
